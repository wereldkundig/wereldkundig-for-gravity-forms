# Real API calls for `composer test:live`. Never commit this file.
WK_TEST_API_URL=https://wereldkundig-platform.test
# Base64 Basic Auth code (the part after "Basic ").
WK_TEST_API_AUTH=

# Herd's local CA, so PHP can verify the *.test certificate.
WK_TEST_API_CA_FILE="${HOME}/Library/Application Support/Herd/config/valet/CA/LaravelValetCASelfSigned.pem"

# Optional: when set, a real subscriber with this address is created on the test platform.
WK_TEST_API_SUBSCRIBE_EMAIL=ci+test@wereldkundig.test

# Browser tests (`npm run test:e2e`): the local site whose form editor is tested.
WK_E2E_URL=https://wereldkundig-platform.test/nissewaard/
# WordPress root, for WP-CLI; relative to this plugin.
WK_E2E_WP_PATH=../../..
