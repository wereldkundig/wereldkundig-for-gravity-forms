 * @param mixed      $array
 * @param string|int $prop
 * @param mixed      $default
 * @return mixed
 */
function rgar($array, $prop, $default = null) {}

/**
 * Arrays are never blank.
 *
 * @param mixed $text
 * @return bool
 */
function rgblank($text) {}

