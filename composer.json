{
    "name": "wereldkundig/wereldkundig-for-gravity-forms",
    "description": "Wereldkundig for Gravity Forms",
    "type": "wordpress-plugin",
    "authors": [
        {
            "name": "Wereldkundig",
            "email": "support@wereldkundig.nl",
            "homepage": "https://wereldkundig.nl"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "pestphp/pest": "^1.23.1",
        "yoast/phpunit-polyfills": "^1.1.5",
        "yoast/wp-test-utils": "^1.2.1",
        "szepeviktor/phpstan-wordpress": "2.0.2",
        "php-stubs/gravity-forms-stubs": "^3.1",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-cli/i18n-command": "^2.7",
        "wp-cli/dist-archive-command": "*"
    },
    "license": "MIT",
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Wereldkundig\\GravityForms\\": "app/"
        }
    },
    "scripts": {
        "build": [
            "rm -rf ./build/stage-1",
            "rm -rf ./build/wereldkundig-for-gravity-forms",
            "rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
            "composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
            "rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/wereldkundig-for-gravity-forms/",
            "vendor/bin/wp i18n make-pot ./build/wereldkundig-for-gravity-forms/ --slug=wereldkundig-for-gravity-forms",
            "vendor/bin/wp i18n make-mo ./build/wereldkundig-for-gravity-forms/languages/",
            "vendor/bin/wp dist-archive ./build/wereldkundig-for-gravity-forms/ --plugin-dirname=wereldkundig-for-gravity-forms --force"
        ],
        "test": [
            "@composer validate --strict",
            "@test:phpcs",
            "@test:unit",
            "@test:phpstan"
        ],
        "test:unit": "@php vendor/bin/pest --configuration phpunit.xml.dist",
        "test:live": "@php vendor/bin/pest --configuration phpunit.live.xml.dist",
        "test:phpstan": "phpstan --memory-limit=2g",
        "test:phpcs": "phpcs",
        "fix": "phpcbf || [ $? -eq 1 ]",
        "docs:hooks": "sh docs/tools/hooks.sh",
        "i18n": [
            "@i18n:make-pot",
            "@i18n:update-po",
            "@i18n:make-mo",
            "@i18n:make-php"
        ],
        "i18n:make-pot": "wp i18n make-pot . languages/wereldkundig-for-gravity-forms.pot --slug=wereldkundig-for-gravity-forms --exclude=docs,test-results,build,.claude,.github,.husky,.wordpress-org",
        "i18n:update-po": "wp i18n update-po languages/wereldkundig-for-gravity-forms.pot languages/",
        "i18n:make-mo": "wp i18n make-mo languages/",
        "i18n:make-php": "wp i18n make-php languages/"
    },
    "scripts-descriptions": {
        "build": "Stages a release copy (via .distignore), installs production Composer deps, regenerates languages, and writes a zip with wp dist-archive.",
        "test": "Validates composer.json, then runs PHPCS, the unit tests and PHPStan. Runs before every git push.",
        "docs:hooks": "Regenerates the hooks reference of the docs site (needs PHP 8.3+).",
        "fix:phpcs": "Fixes what PHPCS can fix automatically.",
        "i18n": "Regenerates the POT from the files that ship, merges it into every PO file in languages/, then compiles the MO and .l10n.php files. Run after changing a translatable string or a PO file."
    },
    "autoload-dev": {
        "psr-4": {
            "Wereldkundig\\GravityForms\\Tests\\": "tests/"
        }
    }
}
