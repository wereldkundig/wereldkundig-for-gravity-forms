---
// Instead of social icons: a link back to the main Wereldkundig docs, in the header and in the mobile menu.
---

<a class="main-docs" href="https://docs.wereldkundig.nl/">{Astro.locals.t('wk.mainDocs')}</a>

<style>
	.main-docs {
		display: inline-flex;
		align-items: center;
		height: 2.5rem;
		padding-inline: 1rem;
		border-radius: 999rem;
		background-color: var(--sl-color-gray-1);
		color: var(--sl-color-black);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: background-color 0.15s;
	}

	.main-docs:hover {
		background-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
</style>
