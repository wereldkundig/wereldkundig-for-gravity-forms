---
// The Wereldkundig logo, plus a label so every page says which docs these are.
import Default from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="site-title-group">
	<Default />
	<span class="product">{Astro.locals.t('wk.product')}</span>
</div>

<style>
	.site-title-group {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		height: 100%;
	}

	.product {
		padding-inline-start: 0.75rem;
		border-inline-start: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		white-space: nowrap;
	}

	@media (max-width: 40em) {
		.product {
			display: none;
		}
	}
</style>
