{
    "$schema": "https://raw.githubusercontent.com/wp-hooks/generator/1.0.2/schema.json",
    "hooks": [
        {
            "name": "wk_gf_api_base_url",
            "file": "Api/Client.php",
            "type": "filter",
            "doc": {
                "description": "The API base URL, e.g. https://subdomein.domein.nl, from the settings or WK_GF_API_URL.",
                "long_description": "The settings page doesn't validate a filtered URL, but every request still refuses plain http except for `localhost`, `*.localhost` and `*.test`.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "string"
                        ],
                        "variable": "$url"
                    }
                ],
                "long_description_html": "<p>The settings page doesn't validate a filtered URL, but every request still refuses plain http except for <code>localhost</code>, <code>*.localhost</code> and <code>*.test</code>.</p>"
            },
            "args": 1
        },
        {
            "name": "wk_gf_api_timeout",
            "file": "Api/Client.php",
            "type": "filter",
            "doc": {
                "description": "The API request timeout in seconds. Default 10.",
                "long_description": "",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "int"
                        ],
                        "variable": "$timeout"
                    },
                    {
                        "name": "param",
                        "content": "GET or POST.",
                        "types": [
                            "string"
                        ],
                        "variable": "$method"
                    },
                    {
                        "name": "param",
                        "content": "/v1/subscribe/fields or /v1/subscribe.",
                        "types": [
                            "string"
                        ],
                        "variable": "$path"
                    }
                ],
                "long_description_html": ""
            },
            "args": 3
        },
        {
            "name": "wk_gf_auto_map_fields",
            "file": "Mapper.php",
            "type": "filter",
            "doc": {
                "description": "Whether to auto-find Email / First name / Middle name / Last name when the feed has no mapping for that field. Default `false`.",
                "long_description": "Return true to fill them from the first matching form field. While it is false, a feed without an email mapping has no email address, so nothing is sent.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "bool"
                        ],
                        "variable": "$enabled"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$form"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$entry"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$feed"
                    }
                ],
                "long_description_html": "<p>Return true to fill them from the first matching form field. While it is false, a feed without an email mapping has no email address, so nothing is sent.</p>"
            },
            "args": 4
        },
        {
            "name": "wk_gf_refresh_fields_initial_delay",
            "file": "FieldsRefresh.php",
            "type": "filter",
            "doc": {
                "description": "Seconds until the first background refresh after the API becomes configured. Default one hour.",
                "long_description": "Later runs follow wk_gf_refresh_fields_recurrence. Negative values count as 0.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "int"
                        ],
                        "variable": "$delay"
                    }
                ],
                "long_description_html": "<p>Later runs follow wk_gf_refresh_fields_recurrence. Negative values count as 0.</p>"
            },
            "args": 1
        },
        {
            "name": "wk_gf_refresh_fields_recurrence",
            "file": "FieldsRefresh.php",
            "type": "filter",
            "doc": {
                "description": "The WP-Cron schedule of the background refresh: hourly (default), twicedaily, daily, or one added with cron_schedules.",
                "long_description": "Unknown schedule names fall back to hourly.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "string"
                        ],
                        "variable": "$recurrence"
                    }
                ],
                "long_description_html": "<p>Unknown schedule names fall back to hourly.</p>"
            },
            "args": 1
        },
        {
            "name": "wk_gf_subscribe_themes",
            "file": "Submission.php",
            "type": "filter",
            "doc": {
                "description": "The themes to subscribe to: theme ID => category option keys, none meaning the whole theme.",
                "long_description": "Return an empty array to skip the subscribe. A per-form variant runs after it: wk_gf_subscribe_themes_{form_id}. For example `['theme-1' => [], 'theme-2' => ['category-3', 'category-4']]` subscribes to the whole of theme-1 and to two categories of theme-2.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string[]>"
                        ],
                        "variable": "$themes"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$entry"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$form"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$feed"
                    }
                ],
                "long_description_html": "<p>Return an empty array to skip the subscribe. A per-form variant runs after it: wk_gf_subscribe<em>themes</em>{form_id}. For example <code>['theme-1' =&gt; [], 'theme-2' =&gt; ['category-3', 'category-4']]</code> subscribes to the whole of theme-1 and to two categories of theme-2.</p>"
            },
            "args": 4
        },
        {
            "name": "wk_gf_subscribe_themes_{$form_id}",
            "file": "Submission.php",
            "type": "filter",
            "doc": {
                "description": "The themes to subscribe to for one form, e.g. wk_gf_subscribe_themes_3 for form 3. Runs after wk_gf_subscribe_themes.",
                "long_description": "",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string[]>"
                        ],
                        "variable": "$themes"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$entry"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$form"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$feed"
                    }
                ],
                "long_description_html": ""
            },
            "args": 4
        },
        {
            "name": "wk_gf_subscriber_pre_subscribe",
            "file": "Submission.php",
            "type": "filter",
            "doc": {
                "description": "The subscriber fields sent to POST /v1/subscribe (email, first_name, middle_name, last_name, company, ...).",
                "long_description": "Return false to skip the subscribe. A per-form variant runs after it: wk_gf_subscriber_pre_subscribe_{form_id}.",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string>",
                            "false"
                        ],
                        "variable": "$subscriber"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string[]>"
                        ],
                        "variable": "$themes"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$entry"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$form"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$feed"
                    }
                ],
                "long_description_html": "<p>Return false to skip the subscribe. A per-form variant runs after it: wk_gf_subscriber_pre<em>subscribe</em>{form_id}.</p>"
            },
            "args": 5
        },
        {
            "name": "wk_gf_subscriber_pre_subscribe_{$form_id}",
            "file": "Submission.php",
            "type": "filter",
            "doc": {
                "description": "The subscriber fields for one form, e.g. wk_gf_subscriber_pre_subscribe_3 for form 3. Runs after wk_gf_subscriber_pre_subscribe.",
                "long_description": "",
                "tags": [
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string>",
                            "false"
                        ],
                        "variable": "$subscriber"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array<string,string[]>"
                        ],
                        "variable": "$themes"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$entry"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$form"
                    },
                    {
                        "name": "param",
                        "content": "",
                        "types": [
                            "array"
                        ],
                        "variable": "$feed"
                    }
                ],
                "long_description_html": ""
            },
            "args": 5
        }
    ]
}